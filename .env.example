# Copia este archivo como ".env" (NO se sube a GitHub) y completa tus datos.

# Cadena de conexión de MongoDB Atlas (Connect → Drivers). Reemplaza <db_password> por la contraseña.
# Si la contraseña tiene símbolos como @ : / ? # escríbelos codificados (@ → %40).
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=CIAP

# Nombre de la base de datos (se crea sola)
MONGODB_DB=ciap

# Puerto local
PORT=3000

# Panel de administración (/admin/). Sin contraseña (8 caracteres o más) el panel queda desactivado.
ADMIN_USER=admin
ADMIN_PASSWORD=
